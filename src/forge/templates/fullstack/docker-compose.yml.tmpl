# Everything running locally with one command: `docker compose up`, then open
# http://localhost:5173. For people only: Forge Web's hosting never runs this file.
services:
  db:
    image: postgres:16
    environment:
      POSTGRES_PASSWORD: dev
      POSTGRES_DB: app
    ports: ["5432:5432"]
    volumes: ["db:/var/lib/postgresql/data"]
    healthcheck:
      test: ["CMD", "pg_isready", "-U", "postgres"]
      interval: 2s
      retries: 30
  server:
    build: ./server
    environment:
      DATABASE_URL: postgresql://postgres:dev@db:5432/app
      APP_URL: http://localhost:5173
    ports: ["8000:8000"]
    depends_on:
      db:
        condition: service_healthy
  web:
    image: node:22
    working_dir: /web
    command: sh -c "npm ci && npm run dev -- --host 0.0.0.0"
    environment:
      API_URL: http://server:8000
    ports: ["5173:5173"]
    volumes: ["./web:/web", "web_modules:/web/node_modules"]
    depends_on: [server]
volumes:
  db:
  web_modules:
