"""Requests that change something come only from the app's own pages: a page on a sibling
subdomain of the apps domain (the same site, so the cookie goes along) cannot sign people out
or block someone for them."""

from collections.abc import Callable
from typing import Any

from fastapi.testclient import TestClient

SignUp = Callable[..., dict[str, Any]]


def test_a_page_on_another_site_cannot_change_anything(
    client: TestClient, new_client: Callable[[], TestClient], sign_up: SignUp
) -> None:
    other = sign_up(new_client(), "grace@example.com")
    sign_up(client)
    for site in ("same-site", "cross-site"):
        headers = {"Sec-Fetch-Site": site}
        assert client.post(f"/api/blocks/{other['id']}", headers=headers).status_code == 403
        assert client.post("/api/auth/logout", headers=headers).status_code == 403
    assert client.get("/api/blocks", headers={"Sec-Fetch-Site": "cross-site"}).json() == []
    own = {"Sec-Fetch-Site": "same-origin"}
    assert client.post(f"/api/blocks/{other['id']}", headers=own).status_code == 204
    assert client.post("/api/auth/logout", headers=own).status_code == 204


def test_older_browsers_are_checked_by_their_origin(client: TestClient, sign_up: SignUp) -> None:
    sign_up(client)
    sibling = {"Origin": "https://evil.app.test"}
    assert client.post("/api/auth/logout", headers=sibling).status_code == 403
    assert client.get("/api/auth/me").status_code == 200  # still signed in
    assert client.post("/api/auth/logout", headers={"Origin": "https://app.test"}).status_code == 204


def test_native_apps_send_neither_header_and_carry_on(client: TestClient, sign_up: SignUp) -> None:
    sign_up(client)  # the test client, like the native apps, sends no Origin, no Sec-Fetch-Site
    assert client.post("/api/auth/logout").status_code == 204
    assert client.get("/api/auth/me").status_code == 401
