"""Exporting and deleting one's own account."""

from collections.abc import Callable
from typing import Any

from fastapi.testclient import TestClient

from conftest import PASSWORD

SignUp = Callable[..., dict[str, Any]]


def test_the_export_holds_everything_stored(
    client: TestClient, new_client: Callable[[], TestClient], sign_up: SignUp
) -> None:
    other = sign_up(new_client(), "grace@example.com")
    sign_up(client)
    report = {"content_type": "user", "content_id": str(other["id"]), "reason": "spam"}
    assert client.post("/api/reports", json=report).status_code == 201
    assert client.post(f"/api/blocks/{other['id']}").status_code == 204
    export = client.get("/api/account/export")
    assert export.status_code == 200
    data = export.json()
    assert data["account"]["email"] == "ada@example.com"
    assert data["reports"][0]["reason"] == "spam"
    assert data["blocked_user_ids"] == [other["id"]]
    assert len(data["sessions"]) == 1
    assert "password" not in export.text and "token" not in export.text


def test_deleting_the_account(client: TestClient, sign_up: SignUp) -> None:
    sign_up(client)
    wrong = client.request("DELETE", "/api/account", json={"password": "not it"})
    assert wrong.status_code == 403
    right = client.request("DELETE", "/api/account", json={"password": PASSWORD})
    assert right.status_code == 204
    assert client.get("/api/auth/me").status_code == 401
    login = {"email": "ada@example.com", "password": PASSWORD}
    assert client.post("/api/auth/login", json=login).status_code == 401


def test_only_a_signed_in_user_can_export_or_delete(client: TestClient) -> None:
    assert client.get("/api/account/export").status_code == 401
    response = client.request("DELETE", "/api/account", json={"password": PASSWORD})
    assert response.status_code == 401
