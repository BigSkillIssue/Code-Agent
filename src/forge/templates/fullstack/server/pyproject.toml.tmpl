[project]
name = "server"
version = "0.1.0"
description = "The server of @@title@@: accounts, moderation and the API the clients use."
requires-python = ">=3.12"
# Exact versions: uv.lock pins the rest. Update with `uv lock --upgrade-package NAME`.
dependencies = [
    "alembic==1.20.0",
    "argon2-cffi==25.1.0",
    "email-validator==2.3.0",
    "fastapi==0.143.0",
    "httpx==0.28.1",
    "psycopg[binary]==3.3.6",
    "sqlalchemy==2.1.4",
    "uvicorn==0.54.0",
]

[dependency-groups]
dev = ["pytest==9.1.1"]

[tool.uv]
package = false

[tool.pytest.ini_options]
testpaths = ["tests"]
pythonpath = ["."]
