"""Signed-in sessions: a `__Host-` cookie (HTTPS only, this host only, not readable by
scripts) holds a random token; the database keeps its hash."""

from datetime import UTC, datetime, timedelta
from typing import Annotated

from fastapi import Depends, HTTPException, Request, Response
from sqlalchemy import delete, select
from sqlalchemy.orm import Session

from app.db import get_db
from app.models import LoginSession, User
from app.security import new_token, token_hash

COOKIE = "__Host-session"


def start_session(db: Session, response: Response, user: User, days: int) -> None:
    """Sign the user in on this browser."""
    token = new_token()
    expires = datetime.now(UTC) + timedelta(days=days)
    db.add(LoginSession(user_id=user.id, token_hash=token_hash(token), expires_at=expires))
    db.commit()
    response.set_cookie(
        COOKIE, token, max_age=days * 86400, path="/", secure=True, httponly=True, samesite="lax"
    )


def end_session(db: Session, request: Request, response: Response) -> None:
    """Sign this browser out."""
    token = request.cookies.get(COOKIE)
    if token:
        db.execute(delete(LoginSession).where(LoginSession.token_hash == token_hash(token)))
        db.commit()
    response.delete_cookie(COOKIE, path="/", secure=True, httponly=True, samesite="lax")


def end_all_sessions(db: Session, user_id: int) -> None:
    """Sign the user out everywhere (after a password change)."""
    db.execute(delete(LoginSession).where(LoginSession.user_id == user_id))


def optional_user(request: Request, db: Annotated[Session, Depends(get_db)]) -> User | None:
    """The signed-in user, or None."""
    token = request.cookies.get(COOKIE)
    if not token:
        return None
    query = (
        select(User)
        .join(LoginSession, LoginSession.user_id == User.id)
        .where(LoginSession.token_hash == token_hash(token))
        .where(LoginSession.expires_at > datetime.now(UTC))
    )
    return db.scalars(query).first()


def current_user(user: Annotated[User | None, Depends(optional_user)]) -> User:
    """The signed-in user; 401 when nobody is signed in."""
    if user is None:
        raise HTTPException(status_code=401, detail="Please sign in.")
    return user


CurrentUser = Annotated[User, Depends(current_user)]
OptionalUser = Annotated[User | None, Depends(optional_user)]
Db = Annotated[Session, Depends(get_db)]
