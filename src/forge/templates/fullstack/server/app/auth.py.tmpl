"""Sign-up, sign-in, sign-out and password reset."""

from datetime import UTC, datetime, timedelta

from fastapi import APIRouter, HTTPException, Request, Response
from pydantic import BaseModel, EmailStr, Field
from sqlalchemy import select

from app.mail import Mail
from app.models import PasswordReset, User
from app.security import hash_password, new_token, token_hash, verify_password
from app.sessions import CurrentUser, Db, end_all_sessions, end_session, start_session

router = APIRouter(prefix="/api/auth", tags=["auth"])
RESET_HOURS = 1


class SignUp(BaseModel):
    """What a new account needs."""

    email: EmailStr
    password: str = Field(min_length=10, max_length=200)
    display_name: str = Field(default="", max_length=80)


class SignIn(BaseModel):
    """Email and password."""

    email: EmailStr
    password: str = Field(max_length=200)


class ResetRequest(BaseModel):
    """The address to send a reset link to."""

    email: EmailStr


class ResetConfirm(BaseModel):
    """The token from the link and the new password."""

    token: str = Field(max_length=200)
    password: str = Field(min_length=10, max_length=200)


class UserOut(BaseModel):
    """A user as the clients see them."""

    id: int
    email: str
    display_name: str
    is_moderator: bool


def user_out(user: User) -> UserOut:
    """The client's view of a user."""
    return UserOut(
        id=user.id,
        email=user.email,
        display_name=user.display_name,
        is_moderator=user.is_moderator,
    )


@router.post("/signup", status_code=201)
def sign_up(body: SignUp, request: Request, response: Response, db: Db) -> UserOut:
    """Make an account and sign in."""
    email = body.email.lower()
    if db.scalars(select(User).where(User.email == email)).first():
        raise HTTPException(status_code=409, detail="There is already an account for this email.")
    user = User(
        email=email,
        password_hash=hash_password(body.password),
        display_name=body.display_name,
        is_moderator=False,
    )
    db.add(user)
    db.commit()
    start_session(db, response, user, request.app.state.settings.session_days)
    return user_out(user)


@router.post("/login")
def sign_in(body: SignIn, request: Request, response: Response, db: Db) -> UserOut:
    """Sign in with email and password."""
    user = db.scalars(select(User).where(User.email == body.email.lower())).first()
    if user is None or not verify_password(user.password_hash, body.password):
        raise HTTPException(status_code=401, detail="Email or password is wrong.")
    start_session(db, response, user, request.app.state.settings.session_days)
    return user_out(user)


@router.post("/logout", status_code=204)
def sign_out(request: Request, response: Response, db: Db) -> None:
    """Sign this browser out."""
    end_session(db, request, response)


@router.get("/me")
def me(user: CurrentUser) -> UserOut:
    """The signed-in user."""
    return user_out(user)


@router.post("/password-reset", status_code=202)
def request_reset(body: ResetRequest, request: Request, db: Db) -> None:
    """Mail a reset link. The answer is the same whether the account exists or not."""
    user = db.scalars(select(User).where(User.email == body.email.lower())).first()
    if user is None:
        return
    token = new_token()
    expires = datetime.now(UTC) + timedelta(hours=RESET_HOURS)
    db.add(PasswordReset(user_id=user.id, token_hash=token_hash(token), expires_at=expires))
    db.commit()
    settings = request.app.state.settings
    link = f"{settings.app_url}/reset-password?token={token}"
    text = (
        f"Someone asked to reset the password of your {settings.app_name} account.\n\n"
        f"Set a new password here (the link works once, for {RESET_HOURS} hour):\n{link}\n\n"
        "If it was not you, ignore this mail; your password stays as it is.\n"
    )
    request.app.state.mailer.send(Mail(to=user.email, subject="Reset your password", text=text))


@router.post("/password-reset/confirm", status_code=204)
def confirm_reset(body: ResetConfirm, db: Db) -> None:
    """Set a new password with a reset link; every session of the account ends."""
    query = select(PasswordReset).where(PasswordReset.token_hash == token_hash(body.token))
    reset = db.scalars(query).first()
    if reset is None or reset.used or reset.expires_at <= datetime.now(UTC):
        raise HTTPException(status_code=400, detail="This link is no longer valid.")
    user = db.get(User, reset.user_id)
    if user is None:
        raise HTTPException(status_code=400, detail="This link is no longer valid.")
    reset.used = True
    user.password_hash = hash_password(body.password)
    end_all_sessions(db, user.id)
    db.commit()
