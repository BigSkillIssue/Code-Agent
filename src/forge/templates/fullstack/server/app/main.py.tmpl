"""The FastAPI application. Hosting starts it with
`uvicorn app.main:create_app --factory` (see forge.app.toml)."""

from typing import Any

from fastapi import FastAPI, HTTPException
from sqlalchemy import text

from app import account, auth, moderation
from app.db import make_engine
from app.mail import Mailer, make_mailer
from app.ratelimit import RateLimiter, rate_limit
from app.sessions import Db
from app.settings import Settings, load_settings
from app.storage import LocalStorage, Storage

VERSION = "0.1.0"


def create_app(
    settings: Settings | None = None,
    mailer: Mailer | None = None,
    storage: Storage | None = None,
) -> FastAPI:
    """The application with its database, mail, storage and rate limits."""
    settings = settings or load_settings()
    app = FastAPI(
        title=settings.app_name,
        version=VERSION,
        openapi_url="/api/openapi.json",
        docs_url="/api/docs",
        redoc_url=None,
    )
    app.state.settings = settings
    app.state.engine = make_engine(settings.database_url)
    app.state.mailer = mailer or make_mailer(settings.mail_relay_url, settings.mail_relay_token)
    app.state.storage = storage or LocalStorage(settings.storage_dir)
    app.state.limiter = RateLimiter(settings.requests_per_minute, settings.auth_requests_per_minute)
    app.middleware("http")(rate_limit)
    app.include_router(auth.router)
    app.include_router(account.router)
    app.include_router(moderation.router)
    app.add_api_route("/healthz", healthz, methods=["GET"], include_in_schema=False)
    return app


def healthz(db: Db) -> dict[str, Any]:
    """Up when the database answers; hosting checks this before and after every release."""
    try:
        db.execute(text("SELECT 1"))
    except Exception as error:  # any database failure means "not healthy"
        raise HTTPException(status_code=503, detail="database unavailable") from error
    return {"status": "ok", "version": VERSION}
