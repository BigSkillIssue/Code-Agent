"""Passwords and tokens."""

import hashlib
import secrets
import threading

from argon2 import PasswordHasher
from argon2.exceptions import InvalidHashError, VerificationError

# Argon2id at OWASP's minimum cost (19 MiB, 2 passes, 1 lane), and at most two hashes at once:
# each holds its memory while it runs, and the server has 512 MiB.
_hasher = PasswordHasher(time_cost=2, memory_cost=19 * 1024, parallelism=1)
_running = threading.BoundedSemaphore(2)


def hash_password(password: str) -> str:
    """An Argon2id hash of the password."""
    with _running:
        return _hasher.hash(password)


def verify_password(password_hash: str, password: str) -> bool:
    """Whether the password matches the hash."""
    try:
        with _running:
            return _hasher.verify(password_hash, password)
    except (VerificationError, InvalidHashError):
        return False


# Checked instead when nobody has the email, so a wrong sign-in takes as long either way.
NO_ACCOUNT_HASH = hash_password(secrets.token_urlsafe(32))


def new_token() -> str:
    """A random token for a cookie or a link."""
    return secrets.token_urlsafe(32)


def token_hash(token: str) -> str:
    """What the database keeps of a token: a leaked table gives no usable token."""
    return hashlib.sha256(token.encode()).hexdigest()
