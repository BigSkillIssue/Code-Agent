import { useState } from "react";
import type { FormEvent } from "react";
import { Link, useSearchParams } from "react-router-dom";
import { api, problem } from "../api/client";

/** Ask for a reset link by mail. */
export function ForgotPassword() {
  const [sent, setSent] = useState(false);

  async function submit(event: FormEvent<HTMLFormElement>) {
    event.preventDefault();
    const email = String(new FormData(event.currentTarget).get("email"));
    await api.POST("/api/auth/password-reset", { body: { email } });
    setSent(true);
  }

  if (sent) return <p>If there is an account for this address, a link is on its way.</p>;
  return (
    <form onSubmit={submit}>
      <h1>Forgot your password?</h1>
      <label>
        Email <input name="email" type="email" autoComplete="email" required />
      </label>
      <button type="submit">Send me a link</button>
    </form>
  );
}

/** Set a new password with the link from the mail. */
export function ResetPassword() {
  const [params] = useSearchParams();
  const [error, setError] = useState("");
  const [done, setDone] = useState(false);

  async function submit(event: FormEvent<HTMLFormElement>) {
    event.preventDefault();
    const password = String(new FormData(event.currentTarget).get("password"));
    const body = { token: params.get("token") ?? "", password };
    const { error } = await api.POST("/api/auth/password-reset/confirm", { body });
    if (error) return setError(problem(error));
    setDone(true);
  }

  if (done) {
    return (
      <p>
        Your password is changed. <Link to="/signin">Sign in</Link>
      </p>
    );
  }
  return (
    <form onSubmit={submit}>
      <h1>Choose a new password</h1>
      <label>
        New password (at least 10 characters){" "}
        <input name="password" type="password" autoComplete="new-password" minLength={10} required />
      </label>
      {error && <p role="alert">{error}</p>}
      <button type="submit">Change password</button>
    </form>
  );
}
