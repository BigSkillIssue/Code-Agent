:root {
  font-family: system-ui, sans-serif;
  color: #1d1d1f;
  background: #fafafa;
}
.page {
  max-width: 40rem;
  margin: 0 auto;
  padding: 1rem;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}
header,
footer {
  display: flex;
  gap: 1rem;
  align-items: center;
}
header nav {
  margin-left: auto;
  display: flex;
  gap: 1rem;
  align-items: center;
}
.brand {
  font-weight: 700;
  text-decoration: none;
  color: inherit;
}
main {
  flex: 1;
}
footer {
  font-size: 0.875rem;
  border-top: 1px solid #ddd;
  padding-top: 0.5rem;
}
form label {
  display: block;
  margin: 0.75rem 0;
}
input {
  display: block;
  width: 100%;
  padding: 0.5rem;
  margin-top: 0.25rem;
  box-sizing: border-box;
}
button.danger {
  background: #b00020;
  color: white;
}
[role="alert"] {
  color: #b00020;
}
@media (prefers-color-scheme: dark) {
  :root {
    color: #f5f5f7;
    background: #111;
  }
}
