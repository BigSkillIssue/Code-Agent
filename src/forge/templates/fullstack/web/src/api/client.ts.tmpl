import createClient from "openapi-fetch";
import type { components, paths } from "./schema";

/**
 * The server's API, typed from server/openapi.json. After the API changes, run
 * `npm run api:types` (it rewrites schema.d.ts) and fix what TypeScript reports.
 */
export const api = createClient<paths>({
  baseUrl: window.location.origin,
  fetch: (request) => globalThis.fetch(request),
});

export type User = components["schemas"]["UserOut"];

/** A message for people from an API error. */
export function problem(error: unknown): string {
  const detail = (error as { detail?: unknown } | undefined)?.detail;
  if (typeof detail === "string") return detail;
  if (Array.isArray(detail)) {
    return detail.map((item: { msg?: string }) => item.msg ?? "").join(" ");
  }
  return "Something went wrong. Please try again.";
}
