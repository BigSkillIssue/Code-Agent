<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="@@namespace@@.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="@@title@@">
    <StackPanel Margin="32" Spacing="12" MaxWidth="420" HorizontalAlignment="Left">
        <TextBlock Text="@@title@@" Style="{StaticResource TitleTextBlockStyle}" />
        <TextBox x:Name="Email" Header="Email" InputScope="EmailSmtpAddress" />
        <PasswordBox x:Name="Password" Header="Password" />
        <Button Content="Sign in" Click="OnSignIn" Style="{StaticResource AccentButtonStyle}" />
        <TextBlock x:Name="Status" TextWrapping="Wrap" />
@@if digital_goods@@
        <Button x:Name="BuyPro" Content="Buy Pro" Click="OnBuyPro" IsEnabled="False" />
@@end@@
        <Button x:Name="DeleteButton" Content="Delete my account" Click="OnDelete" IsEnabled="False" />
    </StackPanel>
</Window>
