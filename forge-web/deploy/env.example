# Copy to forge-web/.env and fill in. docker compose reads it.

# The address people open, and a separate domain for live previews (wildcard DNS
# *.PREVIEW_DOMAIN -> this server). Both point at this server's public IP.
FORGE_DOMAIN=forge.example.com
PREVIEW_DOMAIN=preview.example.net

# For Let's Encrypt (certificate warnings go here).
ACME_EMAIL=admin@example.com

# The group id of "docker" on this server: getent group docker | cut -d: -f3
DOCKER_GID=999

# Client secrets of the sign-in apps (client ids go into forge-web.toml).
GOOGLE_SECRET=
GITHUB_SECRET=
SMTP_PASSWORD=

# Images (defaults: the latest release).
# FORGE_WEB_IMAGE=ghcr.io/bigskillissue/forge-web:latest
# SANDBOX_IMAGE=ghcr.io/bigskillissue/forge-web-sandbox:latest
