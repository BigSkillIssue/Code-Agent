/* @@title@@'s look, as design tokens. docs/DESIGN.md says what each one is for; Forge's UI agent
   sets them for this product from what its people need, so change a token here, not a colour in
   a component. Light by default, dark when the system asks for it. */
:root {
  --paper: #f7f7f5;
  --surface: #ffffff;
  --ink: #1a1c1e;
  --ink-soft: #5b6168;
  --rule: #d9dcdf;
  --accent: #3b5bdb;
  --accent-ink: #ffffff;
  --danger: #b42318;
  --ok: #1f7a3d;
  --font-body: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  --font-display: var(--font-body);
  --step--1: 0.875rem;
  --step-0: 1rem;
  --step-1: 1.25rem;
  --step-2: 1.6rem;
  --step-3: 2.1rem;
  --radius: 6px;
  --measure: 66ch;
  --page: 64rem;
  color-scheme: light dark;
}

@media (prefers-color-scheme: dark) {
  :root {
    --paper: #141618;
    --surface: #1c1f22;
    --ink: #e8eaec;
    --ink-soft: #a2a9b1;
    --rule: #30353a;
    --accent: #8ea6ff;
    --accent-ink: #0f1420;
    --danger: #ff8a7a;
    --ok: #6fd391;
  }
}

*,
*::before,
*::after {
  box-sizing: border-box;
}

body {
  margin: 0;
  background: var(--paper);
  color: var(--ink);
  font-family: var(--font-body);
  font-size: var(--step-0);
  line-height: 1.55;
  -webkit-font-smoothing: antialiased;
}

h1,
h2,
h3 {
  font-family: var(--font-display);
  line-height: 1.2;
  text-wrap: balance;
  margin: 0 0 0.5em;
}
h1 {
  font-size: var(--step-3);
}
h2 {
  font-size: var(--step-2);
}
h3 {
  font-size: var(--step-1);
}
p {
  max-width: var(--measure);
}

a {
  color: var(--accent);
  text-underline-offset: 0.15em;
}

:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 2px;
}

.page {
  max-width: var(--page);
  margin: 0 auto;
  padding: 0 1rem;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

header,
.site-header {
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem 1.25rem;
  align-items: center;
  padding: 1rem 0;
  border-bottom: 1px solid var(--rule);
}
header nav {
  margin-left: auto;
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem 1rem;
  align-items: center;
}
.brand {
  font-family: var(--font-display);
  font-size: var(--step-1);
  font-weight: 700;
  color: inherit;
  text-decoration: none;
}

main {
  flex: 1;
  padding: 2rem 0 3rem;
}

footer,
.site-footer {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem 1.25rem;
  padding: 1rem 0 1.5rem;
  border-top: 1px solid var(--rule);
  font-size: var(--step--1);
  color: var(--ink-soft);
}
footer a,
.site-footer a {
  color: inherit;
}

form {
  max-width: 28rem;
}
form label {
  display: block;
  margin: 0 0 1rem;
  font-weight: 600;
  font-size: var(--step--1);
}
input,
select,
textarea {
  display: block;
  width: 100%;
  margin-top: 0.35rem;
  padding: 0.6rem 0.7rem;
  font: inherit;
  font-weight: 400;
  color: inherit;
  background: var(--surface);
  border: 1px solid var(--rule);
  border-radius: var(--radius);
}
input:focus,
select:focus,
textarea:focus {
  border-color: var(--accent);
  outline: none;
}
input[type="checkbox"] {
  display: inline;
  width: auto;
  margin: 0 0.5rem 0 0;
}

button {
  font: inherit;
  font-weight: 600;
  padding: 0.55rem 1rem;
  border-radius: var(--radius);
  border: 1px solid var(--accent);
  background: var(--accent);
  color: var(--accent-ink);
  cursor: pointer;
}
button:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}
header button {
  background: transparent;
  color: var(--accent);
}
button.danger {
  background: var(--danger);
  border-color: var(--danger);
  color: #fff;
}

[role="alert"] {
  color: var(--danger);
}
[role="status"] {
  color: var(--ok);
}

.offers,
.purchases {
  list-style: none;
  padding: 0;
  display: grid;
  gap: 1rem;
}
.offers > li,
.purchases > li {
  padding: 1rem 0;
  border-top: 1px solid var(--rule);
}

@media (prefers-reduced-motion: reduce) {
  * {
    animation: none !important;
    transition: none !important;
  }
}
