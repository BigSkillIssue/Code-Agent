import { render, screen } from "@testing-library/react";
import { describe, expect, it } from "vitest";
import { App, SITE_NAME } from "./App";

describe("the site", () => {
  it("names itself and links the legal pages hosting serves", () => {
    render(<App />);
    expect(screen.getByRole("heading", { level: 1 }).textContent).toBe(SITE_NAME);
    expect(screen.getByRole("link", { name: "Impressum" }).getAttribute("href")).toBe("/impressum");
    expect(screen.getByRole("link", { name: "Datenschutz" }).getAttribute("href")).toBe("/datenschutz");
  });
});
